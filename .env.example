# Copy to .env and fill in real values. Never commit .env.

# MongoDB connection string.
MONGODB_URI=

# Allowed frontend origin for CORS.
FRONTEND_URL=http://localhost:3000

# Backend port (defaults to 5000 when unset).
PORT=5000

# Single administrator account for the dashboard.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# At least 32 random characters. Rotating this signs out every active session.
SESSION_SECRET=

# Windsor.ai connector API keys, used ONLY by the backend to sync Meta ad
# spend. Never exposed to the frontend and never sent to the browser.
# Each key is one store's Windsor connection, and a connection may contain
# more than one advertising account.
WINDSOR_VIORA_API_KEY=
WINDSOR_TRENDORA_API_KEY=
